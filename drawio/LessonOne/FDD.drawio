                <!-- ==================== CẤP 2 & CẤP 3: PHÂN HỆ 5 ==================== -->
                <!-- 5.1 -->
                <mxCell id="fn_5_1" value="5.1 Quản lý tài khoản và phân quyền [Quản trị - 01]&#10;• 5.1.1 Tạo lập, khóa và cập nhật tài khoản nhân viên&#10;• 5.1.2 Phân quyền vai trò và gán chi nhánh làm việc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="2570" y="280" width="580" height="70" as="geometry"/>
