                <!-- 1.7 -->
                <mxCell id="fn_1_7" value="1.7 Cập nhật trạng thái giao hàng [Bán hàng - 06 / Kho - 04]&#10;• 1.7.1 Cập nhật trạng thái bàn giao đơn hàng&#10;• 1.7.2 Xác nhận hoàn tất giao hàng cho khách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
