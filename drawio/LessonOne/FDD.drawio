                <!-- 1.8 -->
                <mxCell id="fn_1_8" value="1.8 Giải phóng tồn kho giữ chỗ quá hạn [Tự động - 01]&#10;• 1.8.1 Quét danh sách đơn hàng hết thời hạn giữ chỗ&#10;• 1.8.2 Hủy giữ chỗ và hoàn trả số lượng vào tồn khả dụng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;dashed=1;align=left;spacingLeft=12;fontSize=11;fontColor=#0369a1;" parent="1" vertex="1">
