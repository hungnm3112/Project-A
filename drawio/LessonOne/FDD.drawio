                <!-- ==================== CẤP 2 & CẤP 3: PHÂN HỆ 1 ==================== -->
                <!-- 1.1 -->
                <mxCell id="fn_1_1" value="1.1 Gửi yêu cầu đặt hàng [Khách hàng - 01]&#10;• 1.1.1 Nhập thông tin liên hệ và địa chỉ nhận hàng&#10;• 1.1.2 Chọn sản phẩm và số lượng đặt mua&#10;• 1.1.3 Gửi biểu mẫu yêu cầu đặt hàng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="280" width="580" height="80" as="geometry"/>
                </mxCell>
                <!-- 1.2 -->
                <mxCell id="fn_1_2" value="1.2 Xử lý yêu cầu đặt hàng từ website [Bán hàng - 03]&#10;• 1.2.1 Tiếp nhận danh sách yêu cầu form chờ xử lý&#10;• 1.2.2 Xác nhận hoặc hủy yêu cầu sau tư vấn&#10;• 1.2.3 Chuyển đổi yêu cầu hợp lệ thành đơn hàng chính thức" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="380" width="580" height="80" as="geometry"/>
                </mxCell>
                <!-- 1.3 -->
                <mxCell id="fn_1_3" value="1.3 Tạo đơn hàng đa kênh [Bán hàng - 02]&#10;• 1.3.1 Chọn chi nhánh bán và kênh tiếp nhận (Cửa hàng / Điện thoại / Zalo)&#10;• 1.3.2 Kiểm tra tồn khả dụng và giữ chỗ tồn kho tạm thời (Quyết định A1)&#10;• 1.3.3 Lưu thông tin đơn hàng và ghi nhận nhân viên phụ trách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="480" width="580" height="80" as="geometry"/>
                </mxCell>
                <!-- 1.4 -->
                <mxCell id="fn_1_4" value="1.4 Tra cứu tồn kho liên chi nhánh [Bán hàng - 01]&#10;• 1.4.1 Tìm kiếm sản phẩm theo mã hoặc tên&#10;• 1.4.2 Xem số lượng tồn thực tế, đang giữ chỗ và khả dụng theo từng kho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="580" width="580" height="70" as="geometry"/>
                </mxCell>
                <!-- 1.5 -->
                <mxCell id="fn_1_5" value="1.5 Quản lý hồ sơ khách hàng [Bán hàng - 04]&#10;• 1.5.1 Thêm mới và cập nhật thông tin khách hàng&#10;• 1.5.2 Tra cứu lịch sử mua hàng và hạn mức công nợ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="670" width="580" height="70" as="geometry"/>
                </mxCell>
                <!-- 1.6 -->
                <mxCell id="fn_1_6" value="1.6 Tạo yêu cầu đổi trả hàng [Bán hàng - 05]&#10;• 1.6.1 Tra cứu đơn hàng gốc cần đổi trả&#10;• 1.6.2 Chọn sản phẩm, số lượng trả và ghi nhận lý do&#10;• 1.6.3 Phát hành phiếu yêu cầu đổi trả" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
