                <mxCell id="fn_2_1" value="2.1 Quản lý thông tin sản phẩm [Kho - 01 / Quản trị - 03]&#10;• 2.1.1 Thêm mới hồ sơ và thuộc tính sản phẩm&#10;• 2.1.2 Cập nhật giá bán, thông số và trạng thái kinh doanh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
