                <!-- 3.4 -->
                <mxCell id="fn_3_4" value="3.4 Đối soát công nợ khách hàng [Kế toán - 03]&#10;• 3.4.1 Tổng hợp dư nợ phát sinh và đã thu theo kỳ / chi nhánh&#10;• 3.4.2 Theo dõi danh sách khoản nợ đến hạn và quá hạn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1310" y="550" width="580" height="70" as="geometry"/>
