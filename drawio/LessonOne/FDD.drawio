                <!-- 4.2 -->
                <mxCell id="fn_4_2" value="4.2 Theo dõi hiệu quả bán hàng nhân viên [Quản lý - 02]&#10;• 4.2.1 Thống kê số lượng đơn và doanh số thực hiện theo nhân viên&#10;• 4.2.2 Đánh giá tỷ lệ đơn thành công và đơn đổi trả theo kỳ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ca8a04;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1940" y="370" width="580" height="70" as="geometry"/>
