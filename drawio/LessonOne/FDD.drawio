                <!-- ==================== CẤP 2 & CẤP 3: PHÂN HỆ 4 ==================== -->
                <!-- 4.1 -->
                <mxCell id="fn_4_1" value="4.1 Xem báo cáo tổng hợp kinh doanh [Quản lý - 01]&#10;• 4.1.1 Tra cứu báo cáo doanh thu và lợi nhuận dự kiến theo chi nhánh / kênh bán&#10;• 4.1.2 Tra cứu báo cáo tổng hợp tồn kho và công nợ toàn công ty" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ca8a04;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
