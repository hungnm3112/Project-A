                    <mxGeometry x="680" y="560" width="580" height="70" as="geometry"/>
                </mxCell>
                <!-- 2.5 -->
                <mxCell id="fn_2_5" value="2.5 Kiểm tra và nhập kho hàng trả [Kho - 06]&#10;• 2.5.1 Tiếp nhận hàng trả và đánh giá tình trạng vật lý&#10;• 2.5.2 Lập biên bản kiểm hàng và nhập lại kho tương ứng (kho tốt / kho lỗi)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="680" y="650" width="580" height="70" as="geometry"/>
