                },
                {
                  "key": "toDate",
                  "value": "2026-11-30",
                  "description": "Đến ngày tạo"
                }
              ]
            },
            "description": "Quyền: Admin.\n4 vai trò seed sẵn: ADMIN, WAREHOUSE_MANAGER, WAREHOUSE_STAFF, ACCOUNTANT. Có phân trang và bộ lọc theo quy tắc chung (page, limit, keyword, status, fromDate, toDate).\n200: { data: { items: [{ _id, ID, name, permissions, status }], pagination } }\nLỗi: 401, 403.",
            "auth": {
