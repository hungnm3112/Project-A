              "raw": "{{base_url}}/roles/{{role_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "roles",
                "{{role_id}}"
              ]
            },
            "description": "Quyền: Admin.\n200: { data: { _id, ID, name, permissions, status } }\nLỗi: 400, 401, 403, 404.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
