    <diagram id="fdd-module-1-2" name="FDD - Module 1 and 2">
        <mxGraphModel dx="355" dy="437" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1150" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="SƠ ĐỒ PHÂN RÃ CHỨC NĂNG (FDD) - HỆ THỐNG QUẢN LÝ KHO TẬP TRUNG (CÔNG TY TNHH ABC)&#10;MODULE 01: QUẢN LÝ NGƯỜI DÙNG &amp; PHÂN QUYỀN | MODULE 02: QUẢN LÝ DANH MỤC" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="500" y="20" width="1300" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="legend_box" value="CHÚ THÍCH CẤU TRÚC FDD:&#10;• Cấp 0 (Gốc): Hệ thống quản lý kho tập trung (Module 01 &amp; Module 02)&#10;• Cấp 1 (Phân hệ): Khối Module 01 (Users &amp; RBAC) và Module 02 (Master Data)&#10;• Cấp 2: Các nhóm chức năng nghiệp vụ chuẩn hóa (Động từ + Danh từ)&#10;• Cấp 3: Các tác vụ con chi tiết theo quy trình IPO (Nhập -&gt; Xử lý -&gt; Xuất)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;fontColor=#334155;" parent="1" vertex="1">
                    <mxGeometry x="50" y="15" width="420" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="node_root" value="[0] HỆ THỐNG QUẢN LÝ KHO TẬP TRUNG (CÔNG TY TNHH ABC)&#10;MODULE 01: QUẢN LÝ NGƯỜI DÙNG &amp; PHÂN QUYỀN | MODULE 02: QUẢN LÝ DANH MỤC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=3;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="800" y="80" width="680" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="mod_1" value="1. QUẢN LÝ NGƯỜI DÙNG VÀ PHÂN QUYỀN (MODULE 01)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontColor=#6d28d9;fontStyle=1;fontSize=13;align=center;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="180" width="680" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="mod_2a" value="2A. QUẢN LÝ ĐỐI TƯỢNG KINH DOANH VÀ CƠ SỞ (MODULE 02)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2.5;fontColor=#0369a1;fontStyle=1;fontSize=13;align=center;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="780" y="180" width="680" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="mod_2b" value="2B. QUẢN LÝ SẢN PHẨM VÀ ĐỊNH DANH HÀNG HÓA (MODULE 02)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2.5;fontColor=#c2410c;fontStyle=1;fontSize=13;align=center;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="180" width="680" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="edge_root_m1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="node_root" target="mod_1" edge="1">
