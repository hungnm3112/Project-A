<mxfile host="65bd71144e">
    <diagram id="fdd-module-1-2" name="FDD - Module 1 and 2">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1150" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <!-- Header Title -->
                <mxCell id="title" value="SƠ ĐỒ PHÂN RÃ CHỨC NĂNG (FDD) - HỆ THỐNG QUẢN LÝ KHO TẬP TRUNG (CÔNG TY TNHH ABC)&#10;MODULE 01: QUẢN LÝ NGƯỜI DÙNG &amp; PHÂN QUYỀN | MODULE 02: QUẢN LÝ DANH MỤC" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="500" y="20" width="1300" height="40" as="geometry"/>
                </mxCell>

                <!-- Legend Box -->
                <mxCell id="legend_box" value="CHÚ THÍCH CẤU TRÚC FDD:&#10;• Cấp 0 (Gốc): Hệ thống quản lý kho tập trung (Module 01 &amp; Module 02)&#10;• Cấp 1 (Phân hệ): Khối Module 01 (Users &amp; RBAC) và Module 02 (Master Data)&#10;• Cấp 2: Các nhóm chức năng nghiệp vụ chuẩn hóa (Động từ + Danh từ)&#10;• Cấp 3: Các tác vụ con chi tiết theo quy trình IPO (Nhập -&gt; Xử lý -&gt; Xuất)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;fontColor=#334155;" parent="1" vertex="1">
                    <mxGeometry x="50" y="15" width="420" height="75" as="geometry"/>
                </mxCell>

                <!-- Root Node (Level 0) -->
                <mxCell id="node_root" value="[0] HỆ THỐNG QUẢN LÝ KHO TẬP TRUNG (CÔNG TY TNHH ABC)&#10;MODULE 01: QUẢN LÝ NGƯỜI DÙNG &amp; PHÂN QUYỀN | MODULE 02: QUẢN LÝ DANH MỤC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=3;fontColor=#ffffff;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="800" y="80" width="680" height="60" as="geometry"/>
                </mxCell>

                <!-- ==================== CẤP 1: 3 CỘT NGHIỆP VỤ ==================== -->
                <!-- Column 1: Module 01 -->
                <mxCell id="mod_1" value="1. QUẢN LÝ NGƯỜI DÙNG VÀ PHÂN QUYỀN (MODULE 01)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2.5;fontColor=#6d28d9;fontStyle=1;fontSize=13;align=center;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="50" y="180" width="680" height="55" as="geometry"/>
                </mxCell>

                <!-- Column 2: Module 02 - Đối tượng & Cơ sở -->
                <mxCell id="mod_2a" value="2A. QUẢN LÝ ĐỐI TƯỢNG KINH DOANH VÀ CƠ SỞ (MODULE 02)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=2.5;fontColor=#0369a1;fontStyle=1;fontSize=13;align=center;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="780" y="180" width="680" height="55" as="geometry"/>
                </mxCell>

                <!-- Column 3: Module 02 - Sản phẩm & Danh mục -->
                <mxCell id="mod_2b" value="2B. QUẢN LÝ SẢN PHẨM VÀ ĐỊNH DANH HÀNG HÓA (MODULE 02)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2.5;fontColor=#c2410c;fontStyle=1;fontSize=13;align=center;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="180" width="680" height="55" as="geometry"/>
                </mxCell>

                <!-- Connectors from Root to Modules -->
                <mxCell id="edge_root_m1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="node_root" target="mod_1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_root_m2a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="node_root" target="mod_2a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_root_m2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="node_root" target="mod_2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- ==================== CẤP 2 & 3: CỘT 1 (MODULE 01) ==================== -->
                <!-- 1.1 -->
                <mxCell id="fn_1_1" value="1.1 Xác thực và phiên làm việc&#10;• 1.1.1 Đăng nhập hệ thống (Xác thực email, mật khẩu bcrypt và cấp Access/Refresh Token)&#10;• 1.1.2 Cấp mới phiên làm việc (Xác thực Refresh Token và cấp Access Token mới)&#10;• 1.1.3 Đăng xuất hệ thống (Vô hiệu hóa Refresh Token và kết thúc phiên)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="270" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 1.2 -->
                <mxCell id="fn_1_2" value="1.2 Quản lý tài khoản nhân viên&#10;• 1.2.1 Tạo mới tài khoản nhân viên (Thiết lập họ tên, email, mật khẩu khởi tạo)&#10;• 1.2.2 Cập nhật thông tin tài khoản (Chỉnh sửa số điện thoại, thông tin liên hệ)&#10;• 1.2.3 Khóa hoặc mở khóa tài khoản nhân viên (Quản lý trạng thái hoạt động isActive)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="380" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 1.3 -->
                <mxCell id="fn_1_3" value="1.3 Phân quyền vai trò hệ thống&#10;• 1.3.1 Thiết lập danh mục vai trò (Admin, Warehouse Manager, Warehouse Staff, Accountant)&#10;• 1.3.2 Gán hoặc thu hồi vai trò cho nhân viên&#10;• 1.3.3 Kiểm tra quyền truy cập tài nguyên API (RBAC Guard)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="490" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 1.4 -->
                <mxCell id="fn_1_4" value="1.4 Gán nhân viên phụ trách kho&#10;• 1.4.1 Phân công danh sách kho làm việc cho nhân viên (warehouseIds)&#10;• 1.4.2 Điều chỉnh hoặc gỡ bỏ quyền phụ trách kho&#10;• 1.4.3 Kiểm tra phạm vi dữ liệu theo kho phân công (Warehouse Scope Guard)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="600" width="680" height="85" as="geometry"/>
                </mxCell>

                <!-- ==================== CẤP 2 & 3: CỘT 2 (MODULE 02A) ==================== -->
                <!-- 2.6 (Kho hàng) -->
                <mxCell id="fn_2_6" value="2.1 Quản lý cơ sở kho hàng (Warehouses)&#10;• 2.1.1 Khởi tạo danh mục kho hàng (Quản lý 3 kho: Mã kho, tên kho, địa chỉ, thủ kho)&#10;• 2.1.2 Cập nhật thông tin vận hành kho hàng&#10;• 2.1.3 Khóa hoặc ngừng hoạt động kho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="780" y="270" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.4 (Nhà cung cấp) -->
                <mxCell id="fn_2_4" value="2.2 Quản lý nhà cung cấp (Suppliers)&#10;• 2.2.1 Lưu trữ hồ sơ nhà cung cấp (Mã NCC, tên, mã số thuế, SĐT, địa chỉ, email)&#10;• 2.2.2 Cập nhật thông tin giao dịch và người đại diện&#10;• 2.2.3 Quản lý trạng thái hợp tác của nhà cung cấp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="780" y="380" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.5 (Khách hàng) -->
                <mxCell id="fn_2_5" value="2.3 Quản lý hồ sơ khách hàng (Customers)&#10;• 2.3.1 Tạo mới hồ sơ khách hàng (Tên khách hàng, SĐT, email, địa chỉ giao hàng)&#10;• 2.3.2 Cập nhật thông tin liên hệ và phân nhóm khách hàng&#10;• 2.3.3 Tra cứu hồ sơ và thông tin mua hàng của khách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="780" y="490" width="680" height="85" as="geometry"/>
                </mxCell>

                <!-- ==================== CẤP 2 & 3: CỘT 3 (MODULE 02B) ==================== -->
                <!-- 2.1 (Sản phẩm) -->
                <mxCell id="fn_2_1" value="2.4 Quản lý thông tin sản phẩm (Products)&#10;• 2.4.1 Khởi tạo hồ sơ sản phẩm (Tên sản phẩm, mô tả, danh mục, đơn vị tính, NCC)&#10;• 2.4.2 Cập nhật thông tin sản phẩm và chính sách giá&#10;• 2.4.3 Chuyển đổi trạng thái kinh doanh của sản phẩm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="270" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.2 (Danh mục) -->
                <mxCell id="fn_2_2" value="2.5 Quản lý danh mục sản phẩm (Categories)&#10;• 2.5.1 Thiết lập cấu trúc danh mục đa cấp (Pattern Materialized Path: ancestors, path, level)&#10;• 2.5.2 Cập nhật tên, mã slug và phân cấp danh mục&#10;• 2.5.3 Ẩn hoặc xóa danh mục sản phẩm" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="380" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.3 (Đơn vị tính) -->
                <mxCell id="fn_2_3" value="2.6 Quản lý đơn vị tính (Units)&#10;• 2.6.1 Khai báo đơn vị tính hàng hóa (Mã ĐVT, tên ĐVT: cái, chiếc, hộp, mét...)&#10;• 2.6.2 Chỉnh sửa thông tin đơn vị tính&#10;• 2.6.3 Vô hiệu hóa đơn vị tính không còn áp dụng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="490" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.7 (SKU & Barcode) -->
                <mxCell id="fn_2_7" value="2.7 Quản lý mã SKU và Barcode&#10;• 2.7.1 Sinh và kiểm soát tính duy nhất của mã SKU (Stock Keeping Unit)&#10;• 2.7.2 Khởi tạo và liên kết mã vạch Barcode với từng mặt hàng&#10;• 2.7.3 Tra cứu và định danh sản phẩm qua máy quét Barcode Scanner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="600" width="680" height="85" as="geometry"/>
                </mxCell>

                <!-- Footer Summary Box -->
                <mxCell id="footer_box" value="TIÊU CHUẨN THIẾT KẾ MECE CHO MODULE 01 &amp; MODULE 02:&#10;1. Cấp 1 tách biệt hoàn toàn giữa Quản lý con người/truy cập (Module 01) và Dữ liệu danh mục/hàng hóa (Module 02).&#10;2. Cấp 2 tương ứng 1-1 với các Resource RESTful API sẽ xây dựng trong NestJS: /users, /auth, /roles, /warehouses, /suppliers, /customers, /products, /categories, /units.&#10;3. Cấp 3 chi tiết hóa các nghiệp vụ CRUD, xác thực JWT, bảo mật RBAC, cơ chế kiểm soát mã SKU/Barcode duy nhất." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=11;fontColor=#475569;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="50" y="730" width="2140" height="70" as="geometry"/>
                </mxCell>

            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
