                </mxCell>
                <mxCell id="edge_root_m2a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="node_root" target="mod_2a" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_root_m2b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" parent="1" source="node_root" target="mod_2b" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- ==================== CẤP 2 & 3: CỘT 1 (MODULE 01) ==================== -->
                <!-- 1.1 -->
                <mxCell id="fn_1_1" value="1.1 Xác thực và phiên làm việc (auth / refresh_tokens)&#10;• 1.1.1 Đăng nhập hệ thống (Xác thực số điện thoại, mật khẩu sha512 và cấp Access/Refresh Token)&#10;• 1.1.2 Cấp mới phiên làm việc (Xác thực Refresh Token và cấp Access Token mới)&#10;• 1.1.3 Đăng xuất hệ thống (Vô hiệu hóa Refresh Token status = 0 và kết thúc phiên)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="270" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 1.2 -->
                <mxCell id="fn_1_2" value="1.2 Quản lý tài khoản nhân viên (employees)&#10;• 1.2.1 Tạo mới tài khoản nhân viên (Thiết lập mã ID, họ tên, số điện thoại, mật khẩu sha512)&#10;• 1.2.2 Cập nhật thông tin tài khoản (Chỉnh sửa họ tên, số điện thoại)&#10;• 1.2.3 Khóa hoặc mở khóa tài khoản nhân viên (Quản lý trạng thái hoạt động status = 0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="380" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 1.3 -->
                <mxCell id="fn_1_3" value="1.3 Phân quyền vai trò hệ thống (roles)&#10;• 1.3.1 Thiết lập danh mục vai trò (ADMIN, WAREHOUSE_MANAGER, WAREHOUSE_STAFF, ACCOUNTANT)&#10;• 1.3.2 Gán hoặc thay đổi vai trò cho nhân viên (role_id)&#10;• 1.3.3 Kiểm tra quyền truy cập tài nguyên API (RBAC Guard)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="490" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 1.4 -->
                <mxCell id="fn_1_4" value="1.4 Gán nhân viên phụ trách kho (employees.warehouse_ids)&#10;• 1.4.1 Phân công danh sách kho làm việc cho nhân viên (warehouse_ids)&#10;• 1.4.2 Điều chỉnh hoặc gỡ bỏ quyền phụ trách kho&#10;• 1.4.3 Kiểm tra phạm vi dữ liệu theo kho phân công (Warehouse Scope Guard)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#7c3aed;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="50" y="600" width="680" height="85" as="geometry"/>
                </mxCell>

                <!-- ==================== CẤP 2 & 3: CỘT 2 (MODULE 02A) ==================== -->
                <!-- 2.1 (Kho hàng) -->
                <mxCell id="fn_2_6" value="2.1 Quản lý cơ sở kho hàng (warehouses)&#10;• 2.1.1 Khởi tạo danh mục kho hàng (Quản lý 3 kho: Mã kho ID, tên kho, địa chỉ, SĐT, branch_id)&#10;• 2.1.2 Cập nhật thông tin vận hành kho hàng&#10;• 2.1.3 Khóa hoặc ngừng hoạt động kho (status = 0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="780" y="270" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.2 (Nhà cung cấp) -->
                <mxCell id="fn_2_4" value="2.2 Quản lý nhà cung cấp (customers - type = 2)&#10;• 2.2.1 Lưu trữ hồ sơ nhà cung cấp (Mã ID, tên, mã số thuế, SĐT, địa chỉ, email)&#10;• 2.2.2 Cập nhật thông tin giao dịch và liên hệ&#10;• 2.2.3 Quản lý trạng thái hợp tác của nhà cung cấp (status = 0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="780" y="380" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.3 (Khách hàng) -->
                <mxCell id="fn_2_5" value="2.3 Quản lý hồ sơ khách hàng (customers - type = 1, 3)&#10;• 2.3.1 Tạo mới hồ sơ khách hàng (Mã ID, tên khách hàng, SĐT, email, địa chỉ)&#10;• 2.3.2 Cập nhật thông tin liên hệ khách hàng&#10;• 2.3.3 Tra cứu hồ sơ và quản lý trạng thái khách hàng (status = 0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="780" y="490" width="680" height="85" as="geometry"/>
                </mxCell>

                <!-- ==================== CẤP 2 & 3: CỘT 3 (MODULE 02B) ==================== -->
                <!-- 2.4 (Bảng sản phẩm - subcategories) -->
                <mxCell id="fn_2_1" value="2.4 Quản lý thông tin sản phẩm (subcategories - Bảng sản phẩm)&#10;• 2.4.1 Khởi tạo hồ sơ sản phẩm (Tên sản phẩm, category_id, unit_id, giá bán, bảo hành)&#10;• 2.4.2 Cập nhật thông tin sản phẩm và chính sách giá&#10;• 2.4.3 Chuyển đổi trạng thái kinh doanh của sản phẩm (status = 0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="270" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.5 (Danh mục sản phẩm - categories) -->
                <mxCell id="fn_2_2" value="2.5 Quản lý danh mục sản phẩm (categories: Pin, RAM, CPU, Main...)&#10;• 2.5.1 Thiết lập danh mục sản phẩm đa cấp cha - con (parent_id)&#10;• 2.5.2 Cập nhật tên và phân cấp danh mục&#10;• 2.5.3 Ẩn hoặc xóa danh mục chưa sử dụng (status = 0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="380" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.6 (Đơn vị tính) -->
                <mxCell id="fn_2_3" value="2.6 Quản lý đơn vị tính (units)&#10;• 2.6.1 Khai báo đơn vị tính hàng hóa (Tên ĐVT: cái, chiếc, hộp, bộ...)&#10;• 2.6.2 Chỉnh sửa thông tin đơn vị tính&#10;• 2.6.3 Vô hiệu hóa đơn vị tính không còn áp dụng (status = 0 / 1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="490" width="680" height="85" as="geometry"/>
                </mxCell>
                <!-- 2.7 (SKU & Barcode) -->
                <mxCell id="fn_2_7" value="2.7 Quản lý mã SKU và tra cứu mã quét (subcategories.sku / products.ID)&#10;• 2.7.1 Khai báo và kiểm soát mã sản phẩm chung SKU (default: null) trên subcategories&#10;• 2.7.2 Quy ước mã QR / Barcode cá thể (products.ID: mã NCC hoặc timestamp khi nhập kho)&#10;• 2.7.3 Tra cứu và định danh sản phẩm qua máy quét (/subcategories/lookup)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=left;spacingLeft=12;fontSize=11;fontColor=#0f172a;" parent="1" vertex="1">
                    <mxGeometry x="1510" y="600" width="680" height="85" as="geometry"/>
                </mxCell>

                <!-- Footer Summary Box -->
                <mxCell id="footer_box" value="TIÊU CHUẨN THIẾT KẾ MECE &amp; ÁNH XẠ DATABASE LAPTOP24H (MODULE 01 &amp; MODULE 02):&#10;1. Cấp 1 tách biệt hoàn toàn giữa Quản lý con người/truy cập (Module 01) và Dữ liệu danh mục/hàng hóa (Module 02).&#10;2. Cấp 2 ánh xạ trực tiếp sang các Resource RESTful API và 8 bảng MongoDB chuẩn leader: /auth (refresh_tokens), /employees, /roles, /warehouses, /customers (type 1 KH, type 2 NCC, type 3 Khách thợ), /subcategories (Bảng sản phẩm chung kèm mã SKU default: null), /categories (Danh mục sản phẩm), /units.&#10;3. Bảng products (Sản phẩm cuối + mã QR ID theo mã NCC hoặc timestamp Date.now, status: false = chưa xuất) chỉ tự động sinh ra sau khi lập phiếu nhập kho (import_form) ở module tiếp theo." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;dashed=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1.5;fontSize=11;fontColor=#475569;align=left;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="50" y="730" width="2140" height="75" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>