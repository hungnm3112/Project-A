                <mxCell id="acc2_out" value="[Kế toán - 02] Dữ liệu đối soát danh mục Master Data" style="endArrow=classic;html=1;strokeColor=#16a34a;strokeWidth=2;fontSize=10;fontColor=#15803d;labelBackgroundColor=#ffffff;align=center;" parent="1" edge="1">
