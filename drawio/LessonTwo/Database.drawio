                <!-- ==================== HÀNG 2: MODULE 02 (XANH & CAM) ==================== -->
                <mxCell id="t_warehouses" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#0284c7;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;warehouses&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Kho hàng (Module 02)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#e0f2fe;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã kho&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;name&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên kho&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;phone&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;số điện thoại kho&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;address&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;địa chỉ kho&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;branch_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: null&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chi nhánh (ref branches)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default = 1&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;0 dừng hoạt động, 1 đang hoạt động&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;unsign_search&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên, mã kho không dấu&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#0284c7;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="540" width="560" height="350" as="geometry"/>
                </mxCell>

                <mxCell id="t_customers" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#0284c7;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;customers&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Khách hàng / Nhà cung cấp (Module 02)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#e0f2fe;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã khách hàng / nhà cung cấp&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default = 1&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;1 khách hàng, 2 nhà cung cấp&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;name&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên khách hàng / nhà cung cấp&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;phone&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;số điện thoại&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;gender&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giới tính&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;birthday&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Date&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: null&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ngày sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;address&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Array&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default : [ ]&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;danh sách địa chỉ&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;email&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;email&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;tax&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã số thuế&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default = 1&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;0 dừng hoạt động, 1 đang hoạt động&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;unsign_search&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên, mã, sđt không dấu&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#0284c7;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
