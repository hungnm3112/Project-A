                <mxCell id="t_categories" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#ea580c;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;categories&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Danh mục sản phẩm: Pin, RAM, CPU, Main... (Module 02)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffedd5;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;parent_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: null&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;id danh mục cha (null = danh mục gốc)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;name&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên danh mục sản phẩm (Pin, RAM, CPU, Main...)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default = 1&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;0 dừng hoạt động, 1 đang hoạt động&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;unsign_search&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên không dấu để tìm kiếm&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#ea580c;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
