                </mxCell>

                <mxCell id="t_subcategories" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#ea580c;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;subcategories&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Bảng sản phẩm / Sản phẩm chung (Module 02)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffedd5;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;category_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;danh mục sản phẩm (ref categories)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;unit_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;đơn vị tính (ref units)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;name&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên sản phẩm (mẫu sản phẩm)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;sku&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã SKU&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;barcode&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: null&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã vạch barcode&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;price&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giá bán&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;warranty&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;bảo hành (tháng)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default = 1&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;0 dừng hoạt động, 1 đang hoạt động&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;unsign_search&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên, SKU, barcode không dấu&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#ea580c;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="540" width="560" height="410" as="geometry"/>
                </mxCell>

                <!-- ==================== HÀNG 3: NGHIỆP VỤ NHẬP KHO, MÃ QR & CÔNG NỢ (BUỔI HỌC SỐ 2 - XANH LÁ) ==================== -->
                <mxCell id="t_import_form" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;import_form&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Phiếu nhập kho (Buổi học số 2)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;employee_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;nhân viên lập phiếu (ref employees)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;user_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;nhà cung cấp (ref customers)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;warehouse_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;kho nhập (ref warehouses)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;branch_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: null&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chi nhánh (ref branches)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;date&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Date, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default: Date.now&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ngày tạo phiếu&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;total_amount&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tổng tiền phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;product&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Array (detail_product)&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default : [ ]&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chi tiết sản phẩm linh kiện&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;service&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Array (detail_product)&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default : [ ]&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chi tiết sản phẩm dịch vụ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15803d;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1140" width="560" height="390" as="geometry"/>
                </mxCell>

                <mxCell id="t_detail_product" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;detail_product&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Phần tử mảng product / service trong import_form&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;số thứ tự dòng trong phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;subcategory_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;sản phẩm nhập (ref subcategories)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;price&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giá nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;quantity&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;số lượng nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;vat, ck, warranty, discount&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;thuế VAT, chiết khấu (max 100), bảo hành, giảm giá&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15803d;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="660" y="1140" width="560" height="270" as="geometry"/>
                </mxCell>

                <mxCell id="t_products" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;products (sản phẩm cuối + QR)&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Tự sinh sau khi nhập kho (Buổi học số 2)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: Date.now&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã QR (theo mã NCC hoặc sinh theo timestamp)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;subcategory_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;sản phẩm chung (ref subcategories)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;form_import_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;phiếu nhập sinh ra sản phẩm (ref import_form)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;thứ tự dòng trong chi tiết phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;price&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giá&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Boolean&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: false&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mặc định false = chưa xuất kho, true = đã xuất&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15803d;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="1140" width="560" height="310" as="geometry"/>
                </mxCell>

                <mxCell id="t_debts" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;debts &amp;amp; payment_form&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Công nợ &amp;amp; Phiếu thu/chi (Buổi học số 2)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;date&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Date&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default: Date.now&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ngày tạo chứng từ&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;customer_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;nhà cung cấp / khách hàng (ref customers)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;form_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chứng từ phát sinh (ref import_form / payment_form)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;type_form&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;[import, export, receive, payment]&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;loại chứng từ&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;total_import / total_payment&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tổng nhập / tổng thanh toán&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;total_export / total_receive&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tổng xuất / tổng thu&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15803d;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
