                <mxCell id="t_debts" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;debts&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Bảng sổ cái công nợ theo chứng từ (Chuẩn Leader)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;date&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;date&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default: Date.now&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ngày tạo&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;customer_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;nhà cung cấp (ref customers)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;(id chứng từ)&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;id chứng từ gốc (import_form / payment_form...)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;type_form&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;[import, export, receive, payment]&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;loại chứng từ phát sinh công nợ&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;total_import&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0 (VD: 5000)&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tổng tiền nhập (tăng nợ phải trả NCC)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;total_payment&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0 (VD: 2000)&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tổng tiền đã thanh toán (giảm nợ phải trả NCC)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;total_export&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tổng tiền xuất bán (tăng nợ phải thu KH)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1