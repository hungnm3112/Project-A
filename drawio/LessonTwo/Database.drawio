                <mxCell id="t_subcategories" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#ea580c;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;subcategories&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Bảng sản phẩm / Sản phẩm chung (Module 02)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffedd5;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;category_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;danh mục sản phẩm (ref categories)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;unit_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;đơn vị tính (ref units)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;name&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên sản phẩm (mẫu sản phẩm)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;sku&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: null&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã sản phẩm (SKU)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;price&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giá bán&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;warranty&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;bảo hành (tháng)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default = 1&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;0 dừng hoạt động, 1 đang hoạt động&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;unsign_search&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên, mã sản phẩm (lưu cả có dấu và không dấu)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#ea580c;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="1990" y="540" width="560" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="t_import_form" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;import_form&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Phiếu nhập kho (Buổi học số 2)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;employee_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;nhân viên lập phiếu (ref employees)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;user_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;nhà cung cấp (ref customers)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;warehouse_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;kho nhập (ref warehouses)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;branch_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: null&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chi nhánh (ref branches)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;date&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Date, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default: Date.now&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ngày tạo phiếu&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;total_amount&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tổng tiền phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;product&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Array (detail_product)&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default : [ ]&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chi tiết sản phẩm linh kiện&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;service&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Array (detail_product)&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default : [ ]&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chi tiết sản phẩm dịch vụ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15803d;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1140" width="560" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="t_detail_product" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;detail_product&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Phần tử mảng product / service trong import_form&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;số thứ tự dòng trong phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;subcategory_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;sản phẩm nhập (ref subcategories)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;price&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giá nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;quantity&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;số lượng nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;vat&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;thuế VAT&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;ck&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0, max = 100&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;chiết khấu (%)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;warranty&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;bảo hành (tháng)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;discount&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giảm giá&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15803d;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="690" y="1140" width="560" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="t_products" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;products (sản phẩm cuối + QR)&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Tự sinh sau khi nhập kho (Buổi học số 2)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#dcfce7;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;ID&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: Date.now&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mã QR định danh từng chiếc (theo mã NCC nếu có, hoặc tự sinh theo timestamp)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;subcategory_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;sản phẩm chung (ref subcategories)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;form_import_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;phiếu nhập sinh ra sản phẩm (ref import_form)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;thứ tự dòng trong chi tiết phiếu nhập&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;price&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default = 0&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;giá&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Boolean&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;default: false&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;mặc định false = chưa xuất kho, true = đã xuất&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15803d;strokeWidth=2;fillColor=#ffffff;fontColor=#0f172a;verticalAlign=top;align=left;spacing=0;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="1140" width="560" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="t_payment_form" value="&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td colspan=&quot;4&quot; style=&quot;background:#15803d;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;&quot;&gt;payment_form&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:11px;&quot;&gt;Phiếu thanh toán / Phiếu chi - thu&amp;nbsp;&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#dcfce7;font-weight:bold;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #94a3b8;padding:4px;&quot;&gt;field&lt;/td&gt;&lt;td style=&quot;border:1px solid #94a3b8;padding:4px;&quot;&gt;type&lt;/td&gt;&lt;td style=&quot;border:1px solid #94a3b8;padding:4px;&quot;&gt;required&lt;/td&gt;&lt;td style=&quot;border:1px solid #94a3b8;padding:4px;&quot;&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;font-weight:bold;&quot;&gt;_id&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;ObjectId&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;true&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;font-weight:bold;&quot;&gt;ID&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;String&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;true&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;mã phiếu thanh toán (phiếu chi / thu)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;font-weight:bold;&quot;&gt;amount&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;Number&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;default = 0&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;số tiền thanh toán&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;font-weight:bold;&quot;&gt;customer_id&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;ObjectId&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;default = 0&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;nhà cung cấp (ref customers)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;font-weight:bold;&quot;&gt;form_import_id&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;ObjectId&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;null&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;phiếu nhập liên quan (ref import_form)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;font-weight:bold;&quot;&gt;note&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;String&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;default null&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;ghi chú&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;font-weight:bold;&quot;&gt;type_payment_id&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;ObjectId&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;true&lt;/td&gt;&lt;td style=&quot;border:1px solid #cbd5e1;padding:4px;&quot;&gt;hình thức thanh toán (ref type_payments)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;color:#0f172a;&quot;&gt;&lt;td style=&quot;border:1px solid #cbd5