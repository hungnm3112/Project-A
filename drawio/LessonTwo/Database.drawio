                </mxCell>

                <mxCell id="t_units" value="&lt;table style='width:100%;border-collapse:collapse;font-size:11px;color:#0f172a;background:#ffffff;'&gt;&lt;tr&gt;&lt;td colspan='4' style='background:#ea580c;color:#ffffff;font-weight:bold;font-size:13px;padding:6px;text-align:center;'&gt;units&lt;br&gt;&lt;span style='font-weight:normal;font-size:11px;'&gt;Đơn vị tính (Module 02)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#ffedd5;font-weight:bold;color:#0f172a;'&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;field&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;type&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;required&lt;/td&gt;&lt;td style='border:1px solid #94a3b8;padding:4px;'&gt;des&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;_id&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;ObjectId&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;_id hệ thống tự sinh&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;name&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;String, unique&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;tên đơn vị tính: cái, chiếc, hộp, bộ...&lt;/td&gt;&lt;/tr&gt;&lt;tr style='color:#0f172a;'&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;font-weight:bold;'&gt;status&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;Number, Index&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;true, default = 1&lt;/td&gt;&lt;td style='border:1px solid #cbd5e1;padding:4px;'&gt;0 dừng hoạt động, 1 đang hoạt động&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;